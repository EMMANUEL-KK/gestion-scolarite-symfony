{% extends 'Layout/template1.html.twig' %}

{% block title %}
    {{ parent() }} - Professeur index
{% endblock %}

{% block content %}
    <h1>Professeur index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nomp</th>
                <th>Prenomp</th>
                <th>Emailp</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for professeur in professeurs %}
            <tr>
                <td>{{ professeur.id }}</td>
                <td>{{ professeur.nomp }}</td>
                <td>{{ professeur.prenomp }}</td>
                <td>{{ professeur.emailp }}</td>
                <td>
                    <a href="{{ path('app_professeur_show', {'id': professeur.id}) }}">show</a>
                    <a href="{{ path('app_professeur_edit', {'id': professeur.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_professeur_new') }}">Create new</a>
{% endblock %}