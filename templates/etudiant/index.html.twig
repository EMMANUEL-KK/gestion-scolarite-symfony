{% extends 'Layout/template1.html.twig' %}

{% block title %}Liste des étudiants{% endblock %}

{% block content %}

    <h1>Liste des étudiants</h1>
    <hr /><br /><br />

    <table>
        <tr>
            <th>id</th>
            <th>CodeE</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Gérer</th>
        </tr>

        {% for etudiant in etudiants %}
        <tr>
            <td><a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}">{{ etudiant.id }}</a></td>
            <td><a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}">{{ etudiant.cne }}</a></td>
            <td>{{ etudiant.nom }}</td>
            <td>{{ etudiant.prenom }}</td>
            <td class="actions">
                <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}">
                    <img src="{{ asset('images/edit.png') }}" class="icone edit"/>
                </a>
                <a href="{{ path('app_etudiant_delete', {'id': etudiant.id}) }}" onclick="return confirm('Supprimer ?');">
                    <img src="{{ asset('images/delete.png') }}" class="icone delete"/>
                </a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="5">no records found</td>
        </tr>
        {% endfor %}

        <tr>
            <td colspan="5" class="actions">
                <a href="{{ path('app_etudiant_new') }}">
                    <b>Ajouter Nouveau</b>
                    <img src="{{ asset('images/addNew.png') }}" class="icone addNew"/>
                </a>
            </td>
        </tr>
    </table>

{% endblock %}