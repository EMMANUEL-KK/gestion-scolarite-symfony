{% extends 'Layout/template1.html.twig' %}

{% block title %}
    {{ parent() }} -- filiere
{% endblock %}

{% block content %}

    <h1>Liste des filieres</h1>
    <hr /><br /><br />

    <div>
        <table>
            <tr>
                <th>id</th>
                <th>CodeF</th>
                <th>Intitule Filiere</th>
                <th colspan="2">Gérer</th>
            </tr>

            {% for f in filieres %}    
            <tr>
                <td><a href="{{ path('filiere_detail',{'id':f.id}) }}">{{ f.id }}</a></td>
                <td><a href="{{ path('filiere_detail', {'id':f.id}) }}">{{ f.codeF }}</a></td>
                <td><a href="{{ path('filiere_detail',{'id':f.id}) }}">{{ f.intitulef }}</a></td>
                
                {# Voici la correction : on active le lien vers la route de modification #}
                <td class="actions">
                    <a href="{{ path('filiere_edit', {'id': f.id}) }}">
                        <img src="{{ asset('images/edit.png') }}" class="icone edit" title="Modifier"/>
                    </a>
                </td>
                
                <td class="actions">
                    <a href="{{ path('filiere_delete',{'id':f.id}) }}" onclick="return confirm('Supprimer cette filière ?');">
                        <img src="{{ asset('images/delete.png') }}" class="icone delete"/>
                    </a>
                </td>
            </tr>
            {% endfor %}
            
            <tr>
                <td colspan="5" class="actions">
                    <a href="{{ path('filiere_addNew') }}">
                        <b>Ajouter Nouveau</b>
                        <img src="{{ asset('images/addNew.png') }}" class="icone addNew"/>
                    </a>
                </td>
            </tr>
        </table>
    </div>

{% endblock %}