{% extends 'Layout/template1.html.twig' %}
{% block title %}
{{ parent() }}--detail filiere
{% endblock %}
{% block content %}

<h1>Détail de la filiere: </h1>
<hr />
<b> id :      {{ filiere.id}}       </b><br />
<b> Code :    {{ filiere.codef}}    </b><br />
<b> Intitule filiere :     {{ filiere.intitulef}}      </b><br />




<div class="right">
				<a href =
				"{{ path('filiere_edit',{'id':filiere.id})}}">
				Modifier</a>
				<a href =
				"{{ path('filiere_edit',{'id':filiere.id})}}">
				<img src="{{ asset('images/edit.png') }}" class="icone edit"/></a> | 
				<a href =
				"{{ path('filiere_delete',{'id':filiere.id})}}">Supprimer</a>
				<a href =
				"{{ path('filiere_delete',{'id':filiere.id})}}">
                    <img src="{{asset('images/delete.png')}}" class="icone delete"/>
                </a>				
</div>

{% endblock %}